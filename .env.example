# 이 파일을 .env 로 복사해 필요한 값만 수정한다. (.env 는 커밋되지 않는다)

# --- 공통 ---

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=beetle
DB_USER=beetle
DB_PASSWORD=beetlepassword

# 호스트에 노출할 포트. 이미 사용 중인 포트가 있으면 여기서 바꾼다.
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- 로컬(dev) ---

# 백엔드 스프링 프로필. 지정하지 않으면 dev 로 뜬다.
# 값을 비워 두는 것과 dev 로 두는 것은 같다.
SPRING_PROFILES_ACTIVE=dev

# 프론트엔드 빌드 모드. 로컬 이미지는 소스맵을 포함하는 development 가 기본이다.
FRONTEND_BUILD_MODE=development

# --- 배포(prod) ---
#
# 배포는 override 파일을 함께 지정해 띄운다.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# 이때 위의 DB_NAME / DB_USER / DB_PASSWORD / MYSQL_ROOT_PASSWORD 는 **필수**이며,
# 값이 없으면 컨테이너가 기동에 실패한다. 기본 비밀번호로 배포되는 것보다 낫다.
# SPRING_PROFILES_ACTIVE 와 FRONTEND_BUILD_MODE 는 override 파일이 prod/production
# 으로 고정하므로 여기서 신경 쓰지 않아도 된다.
#
# DB 커넥션 풀 크기 (기본 20)
# DB_POOL_SIZE=20
