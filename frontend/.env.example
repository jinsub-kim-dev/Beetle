# 개인 설정용 예시.
#
# 모드별 기본값은 커밋된 `.env.development` / `.env.production` 에 있다.
# 그 값을 개인 환경에서만 바꾸려면 이 파일을 `.env.development.local` 로 복사한다.
# (`*.local` 과 `.env` 는 커밋되지 않는다)

# 개발 서버 포트
VITE_PORT=5173

# 개발 서버가 /api 요청을 넘길 백엔드 주소.
# docker-compose 로 백엔드를 띄웠고 BACKEND_PORT 를 바꿨다면 여기도 맞춘다.
VITE_API_PROXY_TARGET=http://localhost:8080
