# 배포용 이미지. **소스를 빌드하지 않고 미리 만든 `dist` 만 담는다.**
#
# Vite 산출물은 정적 파일이라 아키텍처와 무관하다. `RUN` 이 없으므로 arm64 이미지를
# 만들 때 에뮬레이션이 필요하지 않다.
#
# 빌드 전에 `npm run build` 가 선행되어야 한다. `scripts/deploy.sh` 가 처리한다.
# `dist/` 는 `.dockerignore` 가 막으므로 이 파일 전용 무시 목록을 함께 둔다.
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
