# dev(로컬) 모드 기본값. `npm run dev` 와 `vite build --mode development` 가 읽는다.
#
# 이 파일은 커밋된다. 비밀 값을 넣지 않는다. 개인 설정이 필요하면
# `.env.development.local` 에 두면 이 값을 덮어쓴다. (커밋되지 않음)

# 화면 우측 상단에 환경 배지를 띄우기 위한 값.
VITE_APP_ENV=dev

# 개발 서버 포트
VITE_PORT=5173

# 개발 서버가 /api 요청을 넘길 백엔드 주소.
# docker-compose 로 백엔드를 띄웠고 BACKEND_PORT 를 바꿨다면 여기도 맞춘다.
VITE_API_PROXY_TARGET=http://localhost:8080

# 비워 두면 상대 경로(/api)로 호출한다. 개발 서버가 프록시하므로 오리진이 하나다.
VITE_API_BASE_URL=
